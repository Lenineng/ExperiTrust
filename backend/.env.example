PORT=5001
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/experitrust?retryWrites=true&w=majority
JWT_SECRET=replace_with_long_random_secret
NODE_ENV=development

# Comma-separated frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173

# Optional Cloudinary keys (needed for profile image upload as base64)
CLOUDINAR_CLOUD_NAME=
CLOUDINAR_API_KEY=
CLOUDINAR_API_SECRET=

# Optional admin seeding variables
ADMIN_FULL_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
